+API_AVAILABLE(macos(12.5)) static void install_screenshot_hotkey_monitor(struct screen_capture *sc)
+{
+    if (sc->capture_type != ScreenCaptureDisplayStream)
+        return;
+
+    CGEventMask mask = CGEventMaskBit(kCGEventKeyDown);
+
+    sc->screenshot_event_tap =
+        CGEventTapCreate(kCGSessionEventTap,
+                         kCGHeadInsertEventTap,
+                         kCGEventTapOptionListenOnly,
+                         mask,
+                         screenshot_hotkey_callback,
+                         sc);
+
+    if (!sc->screenshot_event_tap) {
+        MACCAP_LOG(LOG_WARNING,
+                   "Could not create Screenshot hotkey event tap\n");
+        return;
+    }
+
+    sc->screenshot_event_source =
+        CFMachPortCreateRunLoopSource(
+            kCFAllocatorDefault,
+            sc->screenshot_event_tap,
+            0);
+
+    if (!sc->screenshot_event_source) {
+        CFMachPortInvalidate(sc->screenshot_event_tap);
+        CFRelease(sc->screenshot_event_tap);
+        sc->screenshot_event_tap = NULL;
+        return;
+    }
+
+    CFRunLoopAddSource(CFRunLoopGetMain(),
+                       sc->screenshot_event_source,
+                       kCFRunLoopCommonModes);
+
+    CGEventTapEnable(sc->screenshot_event_tap, true);
+
+    MACCAP_LOG(LOG_INFO,
+               "Screenshot hotkey monitor installed\n");
+}
+
+API_AVAILABLE(macos(12.5)) static void destroy_screenshot_hotkey_monitor(struct screen_capture *sc)
+{
+    if (sc->screenshot_event_source) {
+        CFRunLoopRemoveSource(CFRunLoopGetMain(),
+                              sc->screenshot_event_source,
+                              kCFRunLoopCommonModes);
+
+        CFRelease(sc->screenshot_event_source);
+        sc->screenshot_event_source = NULL;
+    }
+
+    if (sc->screenshot_event_tap) {
+        CGEventTapEnable(sc->screenshot_event_tap, false);
+        CFMachPortInvalidate(sc->screenshot_event_tap);
+        CFRelease(sc->screenshot_event_tap);
+        sc->screenshot_event_tap = NULL;
+    }
+}
