+API_AVAILABLE(macos(12.5)) static CGEventRef screenshot_hotkey_callback(CGEventTapProxy proxy,
+                                             CGEventType type,
+                                             CGEventRef event,
+                                             void *refcon)
+{
+    (void) proxy;
+
+    if (type != kCGEventKeyDown)
+        return event;
+
+    struct screen_capture *sc = refcon;
+    if (!sc)
+        return event;
+
+    CGKeyCode keycode =
+        (CGKeyCode) CGEventGetIntegerValueField(
+            event, kCGKeyboardEventKeycode);
+
+    CGEventFlags flags = CGEventGetFlags(event);
+
+    /*
+     * Physical "4" key on a Mac keyboard = keycode 21.
+     * This is a listen-only event tap: the shortcut itself is
+     * not swallowed or modified.
+     */
+    bool command_shift_4 =
+        keycode == 21 &&
+        (flags & kCGEventFlagMaskCommand) &&
+        (flags & kCGEventFlagMaskShift);
+
+    if (!command_shift_4)
+    return event;
+
+/*
+ * Hide the captured cursor immediately on keyDown.
+ * This happens before macOS changes the local pointer to the
+ * Screenshot crosshair.
+ */
+if (!pthread_mutex_lock(&sc->mutex)) {
+    sc->screenshot_filter_active = true;
+    sc->screenshot_hotkey_grace = 0.12f;
+    sc->screenshot_cursor_hidden = true;
+        sc->screenshot_session_active = true;
+
+    pthread_mutex_unlock(&sc->mutex);
+}
+
+if (sc->disp && sc->stream_properties.showsCursor) {
+    sc->stream_properties.showsCursor = NO;
+
+    [sc->disp
+        updateConfiguration:sc->stream_properties
+        completionHandler:^(NSError *_Nullable error) {
+            if (error) {
+                MACCAP_ERR(
+                    "Immediate Screenshot cursor hide failed: %s\n",
+                    [[error localizedFailureReason]
+                        cStringUsingEncoding:NSUTF8StringEncoding]);
+            }
+        }];
+}
+
+    MACCAP_LOG(LOG_INFO,
+               "Screenshot frame freeze: hotkey detected\n");
+
+    return event;
+}
