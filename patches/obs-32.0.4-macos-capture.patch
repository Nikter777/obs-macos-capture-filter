+API_AVAILABLE(macos(12.5)) static bool screenshot_ui_is_visible(void)
+{
+    CFArrayRef window_info =
+        CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly,
+                                   kCGNullWindowID);
+
+    if (!window_info)
+        return false;
+
+    bool found = false;
+
+    for (NSDictionary *window in (NSArray *) window_info) {
+        NSString *name =
+            [window objectForKey:(id) kCGWindowName];
+
+        NSNumber *layer_number =
+            [window objectForKey:(id) kCGWindowLayer];
+
+        if ([name isEqualToString:@"tracking"] &&
+            layer_number &&
+            [layer_number intValue] == 2147483631) {
+            found = true;
+            break;
+        }
+    }
+
+    CFRelease(window_info);
+    return found;
+}
