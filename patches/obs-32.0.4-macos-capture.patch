+API_AVAILABLE(macos(12.5)) static void restore_normal_content_filter(struct screen_capture *sc)
+{
+    if (!sc || !sc->disp ||
+        sc->capture_type != ScreenCaptureDisplayStream)
+        return;
+
+    [SCShareableContent
+        getShareableContentExcludingDesktopWindows:NO
+        onScreenWindowsOnly:NO
+        completionHandler:^(SCShareableContent *_Nullable content,
+                            NSError *_Nullable error) {
+
+            if (error || !content || !sc->disp)
+                return;
+
+            SCDisplay *target_display = nil;
+
+            for (SCDisplay *display in content.displays) {
+                if (display.displayID == sc->display) {
+                    target_display = display;
+                    break;
+                }
+            }
+
+            if (!target_display)
+                return;
+
+            NSMutableArray *exclusions =
+                [[NSMutableArray alloc] init];
+
+            NSString *mainBundleIdentifier =
+                [[NSBundle mainBundle] bundleIdentifier];
+
+            for (SCRunningApplication *app in content.applications) {
+                BOOL shouldExclude =
+                    [app.bundleIdentifier isEqualToString:@"com.openai.chat"] ||
+                    [app.bundleIdentifier isEqualToString:@"com.adguard.mac.vpn"] ||
+                    [app.bundleIdentifier isEqualToString:@"pro.betterdisplay.BetterDisplay"] ||
+                    [app.bundleIdentifier isEqualToString:@"com.apple.dock"] ||
+                    [app.bundleIdentifier isEqualToString:@"com.apple.screencaptureui"];
+
+                if (sc->hide_obs &&
+                    [app.bundleIdentifier isEqualToString:mainBundleIdentifier]) {
+                    shouldExclude = YES;
+                }
+
+                if (shouldExclude)
+                    [exclusions addObject:app];
+            }
+
+            NSArray *empty = [[NSArray alloc] init];
+
+            SCContentFilter *filter =
+                [[SCContentFilter alloc]
+                    initWithDisplay:target_display
+                    excludingApplications:exclusions
+                    exceptingWindows:empty];
+
+            [sc->disp
+                updateContentFilter:filter
+                completionHandler:^(NSError *_Nullable updateError) {
+                    if (!updateError) {
+                        MACCAP_LOG(
+                            LOG_INFO,
+                            "Normal content filter restored\n");
+                    }
+                }];
+
+            [filter release];
+            [empty release];
+            [exclusions release];
+        }];
+}
+
+API_AVAILABLE(macos(12.5)) static void refresh_screenshot_content_filter(struct screen_capture *sc)
+{
+    if (!sc || !sc->disp ||
+        sc->capture_type != ScreenCaptureDisplayStream)
+        return;
+
+    [SCShareableContent
+        getShareableContentExcludingDesktopWindows:NO
+        onScreenWindowsOnly:NO
+        completionHandler:^(SCShareableContent *_Nullable content,
+                            NSError *_Nullable error) {
+
+            if (error || !content || !sc->disp) {
+                if (error) {
+                    MACCAP_ERR(
+                        "Screenshot inclusion content query failed: %s\n",
+                        [[error localizedFailureReason]
+                            cStringUsingEncoding:NSUTF8StringEncoding]);
+                }
+                return;
+            }
+
+            SCDisplay *target_display = nil;
+
+            for (SCDisplay *display in content.displays) {
+                if (display.displayID == sc->display) {
+                    target_display = display;
+                    break;
+                }
+            }
+
+            if (!target_display)
+                return;
+
+            /*
+             * Important difference:
+             *
+             * Instead of capturing the whole display and trying to
+             * exclude the Screenshot tracking overlay, capture only
+             * windows belonging to allowed applications.
+             *
+             * Ownerless tracking windows therefore do not belong to
+             * the permitted application set.
+             */
+            NSMutableArray *included_apps =
+                [[NSMutableArray alloc] init];
+
+            NSString *mainBundleIdentifier =
+                [[NSBundle mainBundle] bundleIdentifier];
+
+            for (SCRunningApplication *app in content.applications) {
+                NSString *bundle = app.bundleIdentifier;
+
+                BOOL excluded =
+                    [bundle isEqualToString:@"com.openai.chat"] ||
+                    [bundle isEqualToString:@"com.adguard.mac.vpn"] ||
+                    [bundle isEqualToString:@"pro.betterdisplay.BetterDisplay"] ||
+                    [bundle isEqualToString:@"com.apple.dock"] ||
+                    [bundle isEqualToString:@"com.apple.screencaptureui"];
+
+                if (sc->hide_obs &&
+                    [bundle isEqualToString:mainBundleIdentifier]) {
+                    excluded = YES;
+                }
+
+                if (!excluded)
+                    [included_apps addObject:app];
+            }
+
+            NSArray *empty = [[NSArray alloc] init];
+
+            SCContentFilter *filter =
+                [[SCContentFilter alloc]
+                    initWithDisplay:target_display
+                    includingApplications:included_apps
+                    exceptingWindows:empty];
+
+            [sc->disp
+                updateContentFilter:filter
+                completionHandler:^(NSError *_Nullable updateError) {
+
+                    if (updateError) {
+                        MACCAP_ERR(
+                            "Screenshot inclusion filter failed: %s\n",
+                            [[updateError localizedFailureReason]
+                                cStringUsingEncoding:NSUTF8StringEncoding]);
+                    } else {
+                        MACCAP_LOG(
+                            LOG_INFO,
+                            "Screenshot inclusion filter active\n");
+                    }
+                }];
+
+            [filter release];
+            [empty release];
+            [included_apps release];
+        }];
+}
